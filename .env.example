# Copy to .env for local experiments. The container reads these from its environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults in src/icd_coder/config.py)
# ICD_CODER_ANTHROPIC_MODEL=claude-haiku-5-5
# ICD_CODER_OPENAI_MODEL=gpt-5.4-mini
# ICD_CODER_BUDGET_USD=4.50
# ICD_CODER_DEADLINE_SECONDS=2700
# ICD_CODER_CONCURRENCY=16
# ICD_CODER_MODEL_DIR=data/models   ("none" disables the learned reranker)

# Any OpenAI-compatible server (Groq, OpenRouter, Together, Mistral, Gemini, Azure, vLLM,
# Ollama). Used when neither official key is set, or with ICD_CODER_PROVIDER=compatible.
# ICD_CODER_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
# ICD_CODER_COMPATIBLE_MODEL=openai/gpt-oss-120b
# ICD_CODER_COMPATIBLE_API_KEY=
# ICD_CODER_COMPATIBLE_PRICE=0.15,0.60   (USD per million input,output tokens)
# ICD_CODER_COMPATIBLE_EFFORT=low
# ICD_CODER_COMPATIBLE_TOKENS_PER_MINUTE=8000

# Claude on Amazon Bedrock, for development with AWS credentials (`aws login`).
# Only used with ICD_CODER_PROVIDER=bedrock; needs the dev dependencies (uv sync).
# ICD_CODER_PROVIDER=bedrock
# ICD_CODER_BEDROCK_MODEL=us.anthropic.claude-haiku-5-5
# ICD_CODER_BEDROCK_REGION=us-east-1
# ICD_CODER_BEDROCK_EFFORT=low   ("none" for models without effort, such as Haiku 4.5)
